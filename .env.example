# PostgreSQL connection string, for example:
#   postgresql://postgres:PASSWORD@localhost:5432/suvarnavarsha
# Leave empty to run without a database: /admin is then off and the site reads src/seed/data.ts.
# First run with a database: create the empty database, then
#   pnpm migrate:create initial   (once, commit the files in src/migrations)
#   pnpm migrate                  (creates the tables)
#   pnpm seed                     (client content, and the super admin from the two lines below)
#   pnpm dev, open /admin and sign in
# Use a database user that owns only this database, and keep PostgreSQL closed to the internet.
DATABASE_URI=
# First super admin, created by `pnpm seed` when there are no accounts yet. Password: 11+
# characters with a capital letter, a small letter, a number and a symbol; put it in "quotes"
# if it contains #. Remove both lines
# from .env after the first sign-in. Always seed before the site goes online: on a database
# with no accounts, whoever opens /admin first can create the super admin.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Secret salt used to hash visitor IPs for enquiry rate limiting
IP_HASH_SALT=

# Must be the exact public address (https, with or without www as visitors use it). In
# production the admin panel only accepts sign-ins coming from this address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
# Google Search Console: the code from its "HTML tag" verification method. Leave empty until
# the property is created.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the code from its "HTML Meta Tag" method (msvalidate.01). Leave empty
# if you verify by importing from Search Console instead.
BING_SITE_VERIFICATION=
# IndexNow key (8–128 letters, numbers or dashes), served at /<key>.txt. Generate one with
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# then run `pnpm indexnow` after launch. Leave empty to turn IndexNow off.
INDEXNOW_KEY=
# Set to off on staging or preview servers: robots.txt then blocks everything and every page
# is sent with noindex. Leave empty (indexing on) for the live site.
SITE_INDEXING=
# Set to true to block AI-training crawlers (GPTBot, ClaudeBot, Google-Extended,
# Applebot-Extended). AI search bots (OAI-SearchBot, PerplexityBot, Claude-SearchBot…) stay allowed.
ROBOTS_BLOCK_AI_TRAINING=

# SMTP for enquiry notification emails. Leave SMTP_HOST empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Suvarnavarsha Gold Website <no-reply@example.com>"
# Address that receives new enquiries
ENQUIRY_NOTIFY_EMAIL=
